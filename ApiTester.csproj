<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject></StartupObject>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- major.minor are set by hand; patch is computed from git at build time (see the
         ComputeVersion target below), so the number the title bar shows says something about
         the code that is actually running. -->
    <VersionPrefix>1.6</VersionPrefix>
    <DebugType>embedded</DebugType>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
    <SignAssembly>False</SignAssembly>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <ApplicationIcon>icons.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!--The InfoVersion carries the short hash itself; the SDK would tack the full 40-char
         one on again.-->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <NeutralLanguage>en</NeutralLanguage>

    <!-- The designer loads toolbar images and the form icon out of the .resx through
         ResourceManager, which counts as a "custom type" and is switched off by default
         once the app is trimmed (which Native AOT implies). -->
    <CustomResourceTypesSupport>true</CustomResourceTypesSupport>

    <!-- The request timing breakdown (DNS, TCP connect, TLS handshake) is collected by
         listening to the System.Net EventSource. Trimming switches EventSource off by
         default, which would leave every duration reading 0. -->
    <EventSourceSupport>true</EventSourceSupport>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;1137</NoWarn>
    <DebugType>embedded</DebugType>
    <Deterministic>False</Deterministic>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
    <Deterministic>False</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="icons.ico" />
  </ItemGroup>

  <!-- Toolbar art and the window icon, read by Assets.cs. Embedded rather than left in the
       .resx so loading them does not depend on runtime type-name resolution. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\*.png" />
    <EmbeddedResource Include="Assets\*.ico" />
  </ItemGroup>

  <!-- tools/ holds the one-off zstd->Brotli converter and vendor/ the FastColoredTextBox
       source; both are separate projects, not part of this one's compile glob. -->
  <ItemGroup>
    <Compile Remove="tools/**;vendor/**" />
    <EmbeddedResource Remove="tools/**;vendor/**" />
    <None Remove="tools/**;vendor/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="vendor\FastColoredTextBox\FastColoredTextBox.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- Microsoft.Data.Sqlite is itself built on SQLitePCLRaw and pulls 2.1.11, whose native
         SQLite binary has a known high severity vulnerability (GHSA-2m69-gcr7-jv3q, unfixed
         across the whole 2.x line). Direct references win over transitive ones, so these lift
         the provider and the bundled SQLite binary to the patched 3.x line. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.2" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
    <PackageReference Include="SQLitePCLRaw.core" Version="3.0.2" />
    <!-- Response bodies are compressed with BrotliStream from the in-box System.IO.Compression. -->
  </ItemGroup>

  <!-- Patch = commits since the last version tag, or the total commit count when there is
       no tag yet; the short hash feeds InformationalVersion, so the title bar reads
       "1.6.42+abcdef0". Run `git tag v1.6.0` whenever a bump deserves a fresh patch count. -->
  <Target Name="ComputeVersion" BeforeTargets="GetAssemblyAttributes" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="git rev-parse --is-inside-work-tree" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="GitOk" />
    </Exec>

    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardErrorImportance="low" Condition="'$(GitOk)' == '0'">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitHashRaw" />
    </Exec>
    <Exec Command="git describe --tags --long --match v$(VersionPrefix).*" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardErrorImportance="low" Condition="'$(GitOk)' == '0'">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitDescribeRaw" />
    </Exec>
    <Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardErrorImportance="low" Condition="'$(GitOk)' == '0'">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCountRaw" />
    </Exec>

    <PropertyGroup>
      <GitHash>$(GitHashRaw.Trim())</GitHash>
      <GitDescribe>$(GitDescribeRaw.Trim())</GitDescribe>
      <GitCount>$(GitCountRaw.Trim())</GitCount>
    </PropertyGroup>

    <!-- The SDK defaults Version from VersionPrefix before any target runs, so picking the
         branch by "is Version still empty" never works. The patch is decided separately. -->
    <PropertyGroup Condition="'$(GitDescribe)' != '' and $(GitDescribe.StartsWith('v$(VersionPrefix).'))">
      <PatchSinceTag>$([System.Text.RegularExpressions.Regex]::Match(`$(GitDescribe)`, `-(\d+)-g[^-]*$`).Groups[1].Value)</PatchSinceTag>
      <TaggedPatch>$([System.Text.RegularExpressions.Regex]::Match(`$(GitDescribe)`, `v\d+\.\d+\.(\d+)`).Groups[1].Value)</TaggedPatch>
      <VersionPatch Condition="'$(PatchSinceTag)' != '' and '$(TaggedPatch)' != ''">$([MSBuild]::Add($(TaggedPatch), $(PatchSinceTag)))</VersionPatch>
    </PropertyGroup>

    <!-- Untagged: patch is the raw commit count; exported without git: zero. -->
    <PropertyGroup Condition="'$(VersionPatch)' == '' and '$(GitCount)' != ''">
      <VersionPatch>$(GitCount)</VersionPatch>
    </PropertyGroup>
    <PropertyGroup Condition="'$(VersionPatch)' == ''">
      <VersionPatch>0</VersionPatch>
    </PropertyGroup>

    <PropertyGroup>
      <Version>$(VersionPrefix).$(VersionPatch)</Version>
      <AssemblyVersion>$(Version)</AssemblyVersion>
      <FileVersion>$(Version)</FileVersion>
      <InformationalVersion Condition="'$(GitHash)' != ''">$(Version)+$(GitHash)</InformationalVersion>
      <InformationalVersion Condition="'$(GitHash)' == ''">$(Version)</InformationalVersion>
    </PropertyGroup>
    <Message Importance="low" Text="API Tester version: $(Version)+$(GitHash)" />
  </Target>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
