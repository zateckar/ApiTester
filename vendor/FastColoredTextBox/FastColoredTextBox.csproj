<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Vendored from https://github.com/xiaoyuvax/FastColoredTextBox (fork of Pavel Torgashov's
    FastColoredTextBox), licensed LGPLv3 - see LICENSE.txt.

    Vendored rather than consumed as a NuGet package because the published control is not
    Native AOT safe: its constructor reads a private field off the TypeDescriptor provider
    via reflection, which returns null once metadata is trimmed. Local changes are marked
    with an "AOT:" comment so they can be found when updating from upstream.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>FastColoredTextBoxNS</RootNamespace>
    <AssemblyName>FastColoredTextBox</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>13</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SignAssembly>false</SignAssembly>
    <DebugType>embedded</DebugType>
    <IsTrimmable>true</IsTrimmable>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>

    <!-- Third party code. Analysing it would produce hundreds of findings we are not going
         to act on, and would drown out warnings in our own sources. -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <AnalysisLevel>none</AnalysisLevel>
    <NoWarn>SYSLIB0001;WFO1000;CS0067;CS0108;CS0114;CS0162;CS0168;CS0169;CS0219;CS0414;CS0618;CS0649;CS0659;CS1717;CS8981;SYSLIB0011;SYSLIB0050;SYSLIB0051;IL2026;IL2050;IL2057;IL2065;IL2067;IL2070;IL2072;IL2075;IL2077;IL2087;IL2090;IL3050</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="AutocompleteMenu.cs"><SubType>Component</SubType></Compile>
    <Compile Update="DocumentMap.cs"><SubType>Component</SubType></Compile>
    <Compile Update="Ruler.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="FastColoredTextBox.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="UnfocusablePanel.cs"><SubType>UserControl</SubType></Compile>
  </ItemGroup>

</Project>
